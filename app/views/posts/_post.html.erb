<article id="<%= dom_id post %>" class="mx-auto w-full py-8">
  <header class="mb-8">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100"><%= post.title %></h1>
  </header>

  <div class="post-content text-lg leading-8 text-gray-800 dark:text-gray-200 space-y-6" data-controller="mermaid">
    <%= post.formatted_body %>
  </div>
</article>
